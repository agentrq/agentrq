{
  "name": "standup",
  "displayName": "Standup",
  "version": "1.0.0",
  "description": "Where this workspace stands: how much work is in each state, what it remembers, and how long any one task's thread has run.",
  "license": "MIT",
  "engines": { "agentrq": ">=0.5" },
