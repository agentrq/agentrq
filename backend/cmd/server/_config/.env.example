# App Configuration
ENV=production # development/production are the only options
PORT=80
AGENTRQ_BASE_URL=https://app.agentrq.com
AGENTRQ_DOMAIN=app.agentrq.com
# On shutdown, how long /readyz fails while requests are still served
AGENTRQ_APP_DRAIN_DELAY=0s

# Reverse proxy (optional)
# Base path prefix the proxy strips before forwarding, e.g. /abc/def
AGENTRQ_BASE_PATH=
# Public domain of the reverse proxy, allowed as a Host header
AGENTRQ_PROXY_DOMAIN=
# Force the cookie Secure flag behind a TLS-terminating proxy
# (default: follows AGENTRQ_SSL_ENABLED)
AGENTRQ_COOKIE_SECURE=

# SSL Configuration (Production only)
AGENTRQ_SSL_ENABLED=false
AGENTRQ_SSL_CACHE_DIR=/_certs
AGENTRQ_SSL_LETSENCRYPT_EMAIL=
AGENTRQ_SSL_CLOUDFLARE_API_TOKEN=
# Optional private bucket certificates are shared through, apart from AGENTRQ_S3_*
AGENTRQ_SSL_S3_ENABLED=false
AGENTRQ_SSL_S3_ENDPOINT=
AGENTRQ_SSL_S3_ACCESS_KEY=
AGENTRQ_SSL_S3_SECRET_ACCESS_KEY=
AGENTRQ_SSL_S3_REGION=us-east-1
AGENTRQ_SSL_S3_BUCKET=

# Database Configuration (SQLite)
AGENTRQ_SQLITE_ENABLED=true
AGENTRQ_SQLITE_DSN=./_storage/agentrq.db

# Database Configuration (PostgreSQL)
AGENTRQ_POSTGRES_ENABLED=false
AGENTRQ_POSTGRES_HOST=localhost
AGENTRQ_POSTGRES_USER=postgres
AGENTRQ_POSTGRES_PASSWORD=postgres
AGENTRQ_POSTGRES_DBNAME=agentrq
AGENTRQ_POSTGRES_PORT=5432

# Authentication
AGENTRQ_AUTH_JWT_SECRET=
AGENTRQ_AUTH_ROOT_ACCESS_TOKEN=agentrq
AGENTRQ_AUTH_ROOT_LOGIN_ENABLED=false
AGENTRQ_AUTH_WORKSPACE_TOKEN_KEY=agentrq-token-key-change-me-32by

# Google OAuth2 (for login)
AGENTRQ_ACCOUNTS_OAUTH2_CLI_GOOGLE_CLIENT_ID=
AGENTRQ_ACCOUNTS_OAUTH2_CLI_GOOGLE_CLIENT_SECRET=

# GitHub OAuth2 (for login)
AGENTRQ_ACCOUNTS_OAUTH2_CLI_GITHUB_CLIENT_ID=
AGENTRQ_ACCOUNTS_OAUTH2_CLI_GITHUB_CLIENT_SECRET=

# SMTP Configuration
AGENTRQ_SMTP_ENABLED=true
AGENTRQ_SMTP_HOST=
AGENTRQ_SMTP_PORT=587
AGENTRQ_SMTP_USERNAME=
AGENTRQ_SMTP_PASSWORD=
AGENTRQ_SMTP_FROM="AgentRQ <no-reply@example.com>"

# Slack Multi-Tenant Integration
AGENTRQ_SLACK_ENABLED=false
AGENTRQ_SLACK_SIGNING_SECRET=
AGENTRQ_SLACK_APP_ID=
AGENTRQ_SLACK_CLIENT_ID=
AGENTRQ_SLACK_CLIENT_SECRET=

# Web Push Notifications (PWA)
# Generate VAPID keys with: npx web-push generate-vapid-keys
AGENTRQ_WEBPUSH_VAPID_PUBLIC_KEY=
AGENTRQ_WEBPUSH_VAPID_PRIVATE_KEY=
# Contact URI shown to push services (mailto: or https:)
AGENTRQ_WEBPUSH_SUBSCRIBER=mailto:hi@example.com

# DDoS Protection & Rate Limiting
AGENTRQ_DDOS_ENABLED=true
AGENTRQ_DDOS_MAX_REQ_PER_SEC=200
AGENTRQ_DDOS_BLOCK_DURATION=1m
AGENTRQ_RATELIMIT_ENABLED=true
AGENTRQ_RATELIMIT_MAX_PER_IP=1200
AGENTRQ_RATELIMIT_MAX_PER_USER=600
AGENTRQ_RATELIMIT_WINDOW=60s
AGENTRQ_TRUSTED_PROXIES=
AGENTRQ_CLIENT_IP_HEADER=X-Real-IP

# Storage
# Writable directory for attachments, and skills when they are local
AGENTRQ_STORAGE_DIR=./_storage
# Attachments older than this are deleted daily (7d, 30d, or a Go duration like 168h)
AGENTRQ_APP_ATTACHMENT_RETENTION=7d
# Max bytes in one memory (default: 16384 / 16 KiB; at most 131072)
AGENTRQ_MEMORY_MAX_FILE_SIZE=16384
# Skill file content: local (<storage dir>/skills) or s3
AGENTRQ_SKILLS_STORAGE=local
# Max size of SKILL.md file (default: 98304 bytes / 96 KiB)
AGENTRQ_SKILLS_MAX_FILE_SIZE=98304
# Max number of files in a skill, including SKILL.md (default: 256)
AGENTRQ_SKILLS_MAX_FILES=256
# Where hook modules are kept, never public: local or s3 (default: local)
AGENTRQ_HOOKS_STORAGE=local
# Let every account upload its own hooks; built-in ones are the root user's (default: false)
AGENTRQ_HOOKS_ALLOW_USER_HOOKS=false
# How long a request to a hook is kept (default: 7d; at least 1d)
AGENTRQ_HOOKS_DELIVERY_RETENTION=7d
# Max bytes in one event payload a hook writes (default: 65536; 1024 to 1048576)
AGENTRQ_HOOKS_MAX_PAYLOAD_SIZE=65536
# Most invitations one team may create in any 24 hours; 0 turns invitations off (default: 10)
AGENTRQ_TEAMS_MAX_INVITES_PER_DAY=10
# Most invitations one account may create in any 24 hours, across all its teams; 0 is no per-account cap (default: 20)
AGENTRQ_TEAMS_MAX_INVITES_PER_USER_PER_DAY=20
# Serve /api/acp/v1 for acp-gateway in native mode (default: true)
AGENTRQ_ACP_V1_ENABLED=true
# OpenAI plugin submission's domain verification token, at /.well-known/openai-apps-challenge (default: none)
AGENTRQ_MCP_OPENAI_APPS_CHALLENGE=
# Attachments (artifacts): local (<storage dir>/artifacts) or s3. Both kinds get public links
AGENTRQ_ARTIFACTS_STORAGE=local

# S3-compatible store, path-style (used when either of the above is s3)
AGENTRQ_S3_ENDPOINT=
AGENTRQ_S3_ACCESS_KEY=
AGENTRQ_S3_SECRET_ACCESS_KEY=
AGENTRQ_S3_REGION=us-east-1
AGENTRQ_S3_BUCKET=
# Base of public links to the bucket (default <endpoint>/<bucket>)
AGENTRQ_S3_PUBLIC_URL=


# Instance Identity
# ID generator node (1-1023); must be unique per running instance.
# Unset, it is derived from the MAC address, which can still collide
MONOFLAKE_NODE=
# Daemon pairing identity (default: node-<MONOFLAKE_NODE>)
AGENTRQ_INSTANCE_ID=
