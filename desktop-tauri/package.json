{
  "name": "agentrq-tauri",
  "private": true,
  "version": "0.13.4",
  "license": "AGPL-3.0-only",
  "description": "AgentRQ desktop app on Tauri (preview)",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --config vite.renderer.config.mjs",
    "build": "tauri build",
    "build:renderer": "vite build --config vite.renderer.config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path core/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml",
    "coverage:rust": "cargo llvm-cov --manifest-path core/Cargo.toml --fail-under-lines 100 --show-missing-lines && cargo llvm-cov --manifest-path src-tauri/Cargo.toml --ignore-filename-regex \"desktop-tauri.(core.|src-tauri.src.(lib|main|test_server|chrome|app_menu|side_panel.(linux|macos|windows|handlers)|oauth_window.handlers)\\.rs)\" --fail-under-lines 100 --show-missing-lines",
    "icons": "node scripts/generate-icons.mjs",
    "tauri": "tauri",
    "build:debug": "npm run build:renderer && tauri build --debug --no-bundle --config scripts/verify.tauri.conf.json",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:connection": "node scripts/verify-connection.mjs",
    "verify:markdown-links": "node scripts/verify-markdown-links.mjs",
    "verify:side-panel": "node scripts/verify-side-panel.mjs",
    "verify:webmcp": "node scripts/verify-webmcp.mjs",
    "verify:ui-telemetry": "node scripts/verify-ui-telemetry.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "author": {
    "name": "AgentRQ",
    "email": "hi@agentrq.com"
  },
  "homepage": "https://agentrq.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentrq/agentrq.git"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
