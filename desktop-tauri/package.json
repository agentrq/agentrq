{
  "name": "agentrq-tauri",
  "private": true,
  "version": "0.13.4",
  "license": "AGPL-3.0-only",
  "description": "AgentRQ desktop app on Tauri (preview)",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --config vite.renderer.config.mjs",
    "build": "tauri build",
    "build:renderer": "vite build --config vite.renderer.config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path core/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml",
    "coverage:rust": "cargo llvm-cov --manifest-path core/Cargo.toml --fail-under-lines 100 && cargo llvm-cov --manifest-path src-tauri/Cargo.toml --ignore-filename-regex \"desktop-tauri.(core.|src-tauri.src.(lib|main|chrome|app_menu)\\.rs)\" --fail-under-lines 100",
    "tauri": "tauri"
  },
  "author": {
    "name": "AgentRQ",
    "email": "hi@agentrq.com"
  },
  "homepage": "https://agentrq.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentrq/agentrq.git"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
