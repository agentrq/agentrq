{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentRQ Tauri",
  "mainBinaryName": "agentrq-tauri",
  "version": "0.13.4",
  "identifier": "com.agentrq.desktop.tauri",
  "build": {
    "beforeDevCommand": "npm run build:ext-host && npm run dev:renderer",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build:ext-host && npm run build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../dist/ext-host/agentrq-ext-host.mjs": "ext-host/agentrq-ext-host.mjs"
    },
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Contextual, Inc.",
    "shortDescription": "Task orchestration for coding agents",
    "longDescription": "Task orchestration for coding agents",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional",
        "depends": ["libayatana-appindicator3-1"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "agentrq-tauri"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/agentrq/agentrq/releases/latest/download/latest-tauri.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDRDA2OTkwNkE1OEZCMzEKUldReCsxaHFrR25RREtVSUJYRFJsZm44MXlGdGlCaWVxYVkyU1NVc3IzZDk4ODdDTVJzS1FRY2QK"
    }
  }
}
