{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window's own webview, on the app scheme: our commands, listening to events, and the title-bar drag. Remote pages (sign-in, side-panel guests) get no capability.",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-tauri-version",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-attachments-forget-all",
    "allow-attachments-forget-task",
    "allow-attachments-forget-workspace",
    "allow-connection-cancel",
    "allow-connection-get",
    "allow-connection-save",
    "allow-connection-validate",
    "allow-notifications-get",
    "allow-notifications-set-muted",
    "allow-profiles-add",
    "allow-profiles-get",
    "allow-profiles-remove",
    "allow-profiles-rename",
    "allow-profiles-switch",
    "allow-files-open",
    "allow-clipboard-write",
    "allow-emoji-show-panel",
    "allow-dialog-choose-directory",
    "allow-extensions-authorize",
    "allow-extensions-choose-folder",
    "allow-extensions-configure",
    "allow-extensions-deauthorize",
    "allow-extensions-drawer",
    "allow-extensions-entries",
    "allow-extensions-install-catalogue",
    "allow-extensions-install-local",
    "allow-extensions-invoke",
    "allow-extensions-refresh",
    "allow-extensions-set-enabled",
    "allow-extensions-set-hook-consent",
    "allow-extensions-state",
    "allow-extensions-supervisor",
    "allow-extensions-uninstall",
    "allow-update-check",
    "allow-update-get",
    "allow-update-install",
    "allow-update-install-via-script",
    "allow-side-panel-open-external",
    "allow-side-panel-pages",
    "allow-side-panel-guest-open",
    "allow-side-panel-guest-place",
    "allow-side-panel-guest-navigate",
    "allow-side-panel-guest-focus",
    "allow-side-panel-guest-snapshot",
    "allow-side-panel-guest-find",
    "allow-side-panel-guest-stop-find",
    "allow-side-panel-guest-close",
    "allow-side-panel-permission-answer",
    "allow-side-panel-permission-remove",
    "allow-side-panel-permissions",
    "allow-view-fullscreen",
    "allow-view-get",
    "allow-view-zoom",
    "allow-theme-set",
    "allow-event-source-open",
    "allow-event-source-close",
    "allow-menu-key-bindings",
    "allow-menu-run",
    "allow-navigation-ready"
  ]
}
