# ────────────────────────────────────────────────────────────────────────────────
# AgentRQ Configuration Template
# ────────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# For local development, you typically only need to set the OAuth credentials.
# Everything else has sensible defaults.
#
# SECURITY WARNING: Never commit .env to version control — it contains secrets.
# Add .env to .gitignore after creating it.
# ────────────────────────────────────────────────────────────────────────────────

# ────────────────────────────────────────────────────────────────────────────────
# REQUIRED: Application & OAuth (Must be configured for any environment)
# ────────────────────────────────────────────────────────────────────────────────

# Environment: 'development' or 'production'
ENV=production

# Public base URL of your AgentRQ instance
# Local: http://localhost:2026
# Production: https://your-domain.com
AGENTRQ_BASE_URL=http://localhost:2026

# Domain (without protocol)
# Local: localhost
# Production: your-domain.com
AGENTRQ_DOMAIN=localhost

# HTTP port (used if not behind a reverse proxy)
PORT=2026

# Base path prefix when behind a reverse proxy (e.g., /abc/def).
# The proxy should strip this prefix before forwarding to AgentRQ.
# Leave empty for root path (default).
AGENTRQ_BASE_PATH=

# Public domain name of the reverse proxy (e.g., example.com).
# Allows requests with this Host header to bypass strict subdomain restrictions.
AGENTRQ_PROXY_DOMAIN=

# Force cookie Secure flag (for TLS-terminating proxies where SSL is
# handled by the proxy but AgentRQ runs on plain HTTP).
# Default: follows AGENTRQ_SSL_ENABLED
AGENTRQ_COOKIE_SECURE=

# ────────────────────────────────────────────────────────────────────────────────
# REQUIRED: Authentication Secrets
# ────────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AGENTRQ_AUTH_JWT_SECRET=CHANGE-ME-TO-A-RANDOM-SECRET-AT-LEAST-32-CHARS

# Encrypts MCP workspace tokens (AES-256-GCM). Must be exactly 32 bytes.
# CRITICAL: If you change this, all existing MCP tokens become unreadable.
# Generate with: openssl rand -hex 16 (produces 32-byte key)
AGENTRQ_AUTH_WORKSPACE_TOKEN_KEY=CHANGE-ME-EXACTLY-32-BYTES-LONG

# ────────────────────────────────────────────────────────────────────────────────
# REQUIRED: Google OAuth2 Credentials
# ────────────────────────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# See SETUP.md for step-by-step instructions
AGENTRQ_ACCOUNTS_OAUTH2_CLI_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
AGENTRQ_ACCOUNTS_OAUTH2_CLI_GOOGLE_CLIENT_SECRET=your-client-secret

# ────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: GitHub OAuth2 Credentials
# ────────────────────────────────────────────────────────────────────────────────
# Adds "Sign in with GitHub". Leave empty to hide it.
# Create at: https://github.com/settings/developers
AGENTRQ_ACCOUNTS_OAUTH2_CLI_GITHUB_CLIENT_ID=your-github-client-id
AGENTRQ_ACCOUNTS_OAUTH2_CLI_GITHUB_CLIENT_SECRET=your-github-client-secret

# ────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: TLS/SSL (for production only)
# ────────────────────────────────────────────────────────────────────────────────
# Enable automatic TLS with Let's Encrypt (production only, requires public domain)
AGENTRQ_SSL_ENABLED=false
AGENTRQ_SSL_LETSENCRYPT_EMAIL=
AGENTRQ_SSL_CACHE_DIR=/_certs
# Optional: Cloudflare API token for DNS challenge (wildcard certs)
AGENTRQ_SSL_CLOUDFLARE_API_TOKEN=

# ────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Database (SQLite by default, PostgreSQL recommended for production)
# ────────────────────────────────────────────────────────────────────────────────
# SQLite: Zero setup, single-file database (default)
AGENTRQ_SQLITE_ENABLED=true
AGENTRQ_SQLITE_DSN=./_storage/agentrq.db

# PostgreSQL: For multi-user/high-concurrency environments
AGENTRQ_POSTGRES_ENABLED=false
AGENTRQ_POSTGRES_HOST=localhost
AGENTRQ_POSTGRES_PORT=5432
AGENTRQ_POSTGRES_USER=postgres
AGENTRQ_POSTGRES_PASSWORD=yourpassword
AGENTRQ_POSTGRES_DBNAME=agentrq

# ────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Root Login (for initial setup only, disable in production)
# ────────────────────────────────────────────────────────────────────────────────
# Allows login without Google OAuth (useful for local development)
AGENTRQ_AUTH_ROOT_LOGIN_ENABLED=true
AGENTRQ_AUTH_ROOT_ACCESS_TOKEN=CHANGE-ME-ROOT-TOKEN

# ────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Return to another site after signing in
# ────────────────────────────────────────────────────────────────────────────────
# /login?redirect_url=<address> sends the person back there once they have
# signed in. An address on this server always works; list any other hosts here,
# comma separated. A host must match exactly, and anything else goes to the app.
# AGENTRQ_AUTH_ALLOWED_REDIRECT_DOMAINS=app.example.com,docs.example.com

# ────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Email Notifications (SMTP)
# ────────────────────────────────────────────────────────────────────────────────
AGENTRQ_SMTP_ENABLED=false
AGENTRQ_SMTP_HOST=smtp.example.com
AGENTRQ_SMTP_PORT=587
AGENTRQ_SMTP_USERNAME=user@example.com
AGENTRQ_SMTP_PASSWORD=yourpassword
AGENTRQ_SMTP_FROM=AgentRQ <no-reply@example.com>

# ────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Slack Integration
# ────────────────────────────────────────────────────────────────────────────────
# Create a Slack App at: https://api.slack.com/apps
# See integrations/slack/README.md for detailed setup
AGENTRQ_SLACK_ENABLED=false
AGENTRQ_SLACK_CLIENT_ID=your-slack-client-id
AGENTRQ_SLACK_CLIENT_SECRET=your-slack-client-secret
AGENTRQ_SLACK_SIGNING_SECRET=your-slack-signing-secret
AGENTRQ_SLACK_APP_ID=your-slack-app-id

# ────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Web Push Notifications (PWA)
# ────────────────────────────────────────────────────────────────────────────────
# Generate VAPID keys with: npx web-push generate-vapid-keys
AGENTRQ_WEBPUSH_VAPID_PUBLIC_KEY=
AGENTRQ_WEBPUSH_VAPID_PRIVATE_KEY=
# Contact URI shown to push services (mailto: or https:)
AGENTRQ_WEBPUSH_SUBSCRIBER=mailto:hi@example.com

# ────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Storage
# ────────────────────────────────────────────────────────────────────────────────
# Writable directory for attachments, and skill files when they are local
# (under skills/). Point it at a mounted volume in a container.
AGENTRQ_STORAGE_DIR=./_storage

# Attachment files older than this are deleted daily at midnight UTC.
# Day values (7d, 30d) or Go durations (168h). Skill files are never deleted.
AGENTRQ_APP_ATTACHMENT_RETENTION=7d

# Where skill files and attachments (artifacts) are kept: 'local'
# (<storage dir>/skills and <storage dir>/artifacts) or 's3'. Each file gets a
# public link either way: <AGENTRQ_BASE_URL>/storage/... when local, the bucket
# when s3, which must then allow public reads under skills/ and artifacts/.
AGENTRQ_SKILLS_STORAGE=local
AGENTRQ_ARTIFACTS_STORAGE=local
# The files of Pano docs, the same way, under pano/ (their markdown is in the database).
AGENTRQ_PANO_STORAGE=local

# The most days a Pano doc may live after its last save. A doc lives 30 days
# unless its save asks for another number, which is capped at this.
AGENTRQ_PANO_MAX_TTL_DAYS=365

# Size limits, in bytes and files. A value that is not a whole number, or a
# memory size over 131072, stops the server from starting.
AGENTRQ_MEMORY_MAX_FILE_SIZE=16384
AGENTRQ_SKILLS_MAX_FILE_SIZE=98304
AGENTRQ_SKILLS_MAX_FILES=256

# Serve /api/acp/v1 for acp-gateway in native mode (--acp-version 1).
AGENTRQ_ACP_V1_ENABLED=true

# Any S3-compatible store (AWS S3, MinIO, Cloudflare R2...), addressed
# path-style. Only used when one of the two above is s3. The bucket must exist.
AGENTRQ_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
AGENTRQ_S3_ACCESS_KEY=
AGENTRQ_S3_SECRET_ACCESS_KEY=
AGENTRQ_S3_REGION=us-east-1
AGENTRQ_S3_BUCKET=
# Base of public links to the bucket, e.g. a CDN. Empty means <endpoint>/<bucket>.
AGENTRQ_S3_PUBLIC_URL=

# ────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Security (DDoS Protection & Rate Limiting)
# ────────────────────────────────────────────────────────────────────────────────
AGENTRQ_DDOS_ENABLED=true
AGENTRQ_DDOS_MAX_REQ_PER_SEC=20
AGENTRQ_DDOS_BLOCK_DURATION=5m

AGENTRQ_RATELIMIT_ENABLED=true
AGENTRQ_RATELIMIT_MAX_PER_IP=60
AGENTRQ_RATELIMIT_MAX_PER_USER=100
AGENTRQ_RATELIMIT_WINDOW=60s

# ────────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Multiple Instances
# ────────────────────────────────────────────────────────────────────────────────
# ID generator node, 0-1023. MUST be unique per running instance, or IDs
# collide. Also identifies this instance when a daemon (agentrqd) is paired.
MONOFLAKE_NODE=1

# Overrides the instance identity used for daemon pairing.
# Default: node-<MONOFLAKE_NODE>
AGENTRQ_INSTANCE_ID=

# Behind a load balancer: probe GET /healthz (liveness) and GET /readyz
# (readiness). On shutdown /readyz fails for this long while requests are still
# served, so traffic moves away first. Keep it above the probe interval.
AGENTRQ_APP_DRAIN_DELAY=0s
